[
  {"id": "q01", "text": "오늘 하루 중에 제일 웃겼던 순간이 언제였어요?", "time_tags": ["evening", "late_night"], "heavy": false, "used_at": null},
  {"id": "q02", "text": "요즘 자기 전에 꼭 하는 게 있어요?", "time_tags": ["evening", "late_night"], "heavy": false, "used_at": null},
  {"id": "q03", "text": "오늘 아침에 제일 먼저 한 생각이 뭐였어요?", "time_tags": ["morning"], "heavy": false, "used_at": null},
  {"id": "q04", "text": "점심 뭐 먹었어요? 다음에 같이 먹고 싶은 메뉴 있어요?", "time_tags": ["afternoon"], "heavy": false, "used_at": null},
  {"id": "q05", "text": "최근에 저장해둔 사진 중에 제일 마음에 드는 게 뭐예요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q06", "text": "요즘 무한 반복해서 듣는 노래가 있어요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q07", "text": "다음 주말에 하루가 통째로 비면 뭘 하고 싶어요?", "time_tags": ["evening", "afternoon"], "heavy": false, "used_at": null},
  {"id": "q08", "text": "최근에 새로 알게 된 가게가 있어요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q09", "text": "어릴 때 제일 좋아했던 간식이 뭐였어요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q10", "text": "돈 신경 안 쓰고 하루 여행 간다면 어디로 갈래요?", "time_tags": ["evening"], "heavy": false, "used_at": null},
  {"id": "q11", "text": "요즘 보고 있는 드라마나 영상 있어요?", "time_tags": ["evening", "late_night"], "heavy": false, "used_at": null},
  {"id": "q12", "text": "오늘 날씨는 어땠어요? 밖에 오래 있었어요?", "time_tags": ["afternoon", "evening"], "heavy": false, "used_at": null},
  {"id": "q13", "text": "지금 제일 사고 싶은 게 뭐예요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q14", "text": "최근에 배워보고 싶다고 생각한 게 있어요?", "time_tags": ["afternoon", "evening"], "heavy": false, "used_at": null},
  {"id": "q15", "text": "휴대폰 배경화면 지금 뭐로 해뒀어요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q16", "text": "오늘 가장 오래 앉아 있었던 곳이 어디예요?", "time_tags": ["evening"], "heavy": false, "used_at": null},
  {"id": "q17", "text": "다시 가보고 싶은 동네가 있어요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q18", "text": "요즘 냉장고에 항상 있는 게 뭐예요?", "time_tags": ["morning", "afternoon"], "heavy": false, "used_at": null},
  {"id": "q19", "text": "출근길이나 등굣길에 주로 뭐 해요?", "time_tags": ["morning"], "heavy": false, "used_at": null},
  {"id": "q20", "text": "최근에 웃겨서 저장해둔 짤 있으면 보여줄래요?", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q21", "text": "지금 당장 야식 하나 시킬 수 있다면 뭐 시킬래요?", "time_tags": ["late_night"], "heavy": false, "used_at": null},
  {"id": "q22", "text": "이번 주에 제일 잘한 일 하나만 꼽아볼래요?", "time_tags": ["evening"], "heavy": false, "used_at": null},
  {"id": "q23", "text": "좋아하는 계절이 언제예요? 이유도 궁금해요", "time_tags": ["any"], "heavy": false, "used_at": null},
  {"id": "q24", "text": "요즘 알람 몇 시에 맞춰놔요?", "time_tags": ["late_night", "morning"], "heavy": false, "used_at": null},
  {"id": "q25", "text": "한 달 뒤에 뭘 하고 있을 것 같아요?", "time_tags": ["evening"], "heavy": true, "used_at": null},
  {"id": "q26", "text": "요즘 제일 고마웠던 사람이 있어요?", "time_tags": ["evening"], "heavy": true, "used_at": null},
  {"id": "q27", "text": "최근에 마음이 놓였던 순간이 있었어요?", "time_tags": ["evening"], "heavy": true, "used_at": null},
  {"id": "q28", "text": "요즘 제일 신경 쓰이는 일이 뭐예요?", "time_tags": ["evening"], "heavy": true, "used_at": null},
  {"id": "q29", "text": "올해 하고 싶은 것 중에 아직 못 한 게 있어요?", "time_tags": ["evening", "afternoon"], "heavy": true, "used_at": null},
  {"id": "q30", "text": "서로한테 제일 고마웠던 순간 하나씩 말해볼래요?", "time_tags": ["evening"], "heavy": true, "used_at": null}
]

# 이 파일을 .env 로 복사해서 값을 채운다.
OPENAI_API_KEY=sk-...

# 판정 · 생성에 쓰는 모델. init_chat_model 형식("provider:model")
KAKAPO_MODEL=openai:gpt-5

# 비워두면 temperature 를 아예 넘기지 않는다 (reasoning 모델 대응)
KAKAPO_TEMPERATURE=0.3

# 기억 임베딩 모델
KAKAPO_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# 외부 API — 없으면 해당 기능만 조용히 미발동한다 (워커는 죽지 않는다)
# ---------------------------------------------------------------------------

# 데이트 코스 추천 — 카카오 로컬 API (장소 검색 + place_url)
#   https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
#   무료, 일 100,000회. 카카오 로그인 설정은 필요 없다.
#   ⚠️ 키 발급만으로는 안 된다. 앱에서 **카카오맵 서비스를 켜야** 한다:
#      앱 설정 → 플랫폼 → Web 플랫폼 등록(http://localhost)
#      → 제품 설정 → 카카오맵 → 활성화 ON
#      안 켜면 403 "disabled OPEN_MAP_AND_LOCAL service" 가 뜬다.
#   ⚠️ 이 키가 없으면 데이트 코스는 발동하지 않는다. LLM 이 장소를 지어내면
#      존재하지 않는 가게와 죽은 링크가 화면에 뜨기 때문에 일부러 막아뒀다.
KAKAO_REST_API_KEY=a747c441e7f7edd4193fece91996642b

# 유튜브 영상 추천 — YouTube Data API v3
#   https://console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 설정 → API 키
#   무료 할당량 하루 10,000 units. search.list 가 호출당 100 units 라
#   추천 1건에 약 105 units → 하루 약 95회. 개발 중 반복 실행에 주의.
YOUTUBE_API_KEY=
